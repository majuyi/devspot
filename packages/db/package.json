{
  "name": "@devspot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/sync-registry.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma validate && prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "migrate:deploy": "prisma migrate deploy && echo 'Production: migrate.yml applies packages/db/prisma/grants.sql after this.'",
    "sync-registry": "tsx --env-file-if-exists=../../.env scripts/sync-registry.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@devspot/schema": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.5",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
