{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@devspot/db#test": {
      "dependsOn": ["build"]
    }
  },
  "globalEnv": ["DATABASE_URL", "DIRECT_URL", "NODE_ENV", "NEXT_PUBLIC_SITE_URL"]
}
