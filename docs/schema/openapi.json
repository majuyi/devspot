              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "slug",
              "name",
              "url"
            ],
            "additionalProperties": false
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri"
          },
          "applyUrl": {
