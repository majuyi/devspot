{
  "openapi": "3.1.0",
  "info": {
    "title": "devspot API",
    "version": "1",
    "description": "Read-only opportunities for early-career tech people in Nigeria. Only published and closed opportunities exist here. Requirements are verbatim from the organisation; nothing in this API says who is eligible.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/opportunities": {
      "get": {
        "summary": "List opportunities",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "kinds",
            "schema": {
              "description": "Comma-separated kinds, e.g. job,internship",
              "type": "string"
            },
            "description": "Comma-separated kinds, e.g. job,internship"
          },
          {
            "in": "query",
            "name": "city",
            "schema": {
              "type": "string",
              "enum": [
                "lagos",
                "abuja",
                "ibadan",
                "port-harcourt",
                "enugu",
                "kano",
                "benin-city",
                "kaduna",
                "jos",
                "calabar",
                "uyo",
                "owerri",
                "abeokuta",
                "ilorin",
                "akure",
                "ile-ife"
              ]
            }
          },
          {
            "in": "query",
            "name": "country",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          {
            "in": "query",
            "name": "remote",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "description": "Comma-separated tags; any one matches",
              "type": "string"
            },
            "description": "Comma-separated tags; any one matches"
          },
          {
            "in": "query",
            "name": "org",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "default": "published",
              "type": "string",
              "enum": [
                "published",
                "closed",
                "all"
              ]
            }
          },
          {
            "in": "query",
            "name": "closingWithin",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          },
          {
            "in": "query",
            "name": "updatedSince",
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "deadline",
              "type": "string",
              "enum": [
                "deadline",
                "new",
                "updated"
              ]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 30,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of opportunities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpportunityPage"
                }
              }
            }
          },
          "400": {
            "description": "A query parameter is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited: 60 requests a minute per IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
