            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Opportunity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "internship",
              "job",
              "fellowship",
              "scholarship",
              "grant",
              "hackathon",
              "ossProgram",
              "event",
              "competition",
              "accelerator",
              "bootcamp"
            ]
          },
          "summary": {
