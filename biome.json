{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/src/generated",
      "!**/.next",
      "!**/dist",
      "!**/test/fixtures",
      "!docs/schema"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDefaultExport": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["packages/schema/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@devspot/db": "@devspot/schema imports nothing from the workspace.",
                  "@devspot/engine": "@devspot/schema imports nothing from the workspace.",
                  "@devspot/web": "@devspot/schema imports nothing from the workspace."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@devspot/engine": "@devspot/db imports @devspot/schema only.",
                  "@devspot/web": "@devspot/db imports @devspot/schema only."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@devspot/engine": "The app never imports the engine. Shared logic lives in @devspot/schema or @devspot/db."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@devspot/web": "The engine never imports the app."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/engine/src/fetchers/**",
        "packages/engine/src/adapters/**",
        "packages/engine/src/extract/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@devspot/db": "Fetchers, adapters and extractors never import the database. Return values; the loader writes.",
                  "@devspot/web": "The engine never imports the app."
                }
              }
            }
          }
        }
      }
    }
  ]
}
